<%= t(".asked_for_password_change",
      user: @user.username,
      domain: @domain) %><br>
<%= t(".code_for_password_change",
      change_link: link_to(CGI.unescape(@change_link), @change_link),
      reset_token: @reset_token,
      ttl: distance_of_time_in_words(Time.current, Time.current + User::PasswordReset::RESET_TOKEN_TTL)).html_safe %>
