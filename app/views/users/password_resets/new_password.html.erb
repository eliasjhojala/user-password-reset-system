<% if @submit_token_expired %>
  <p class="help notice warning"><%= t('.submit_token_expired') %></p>
  <p><%= link_to t('.request_new_link'), new_password_reset_path %></p>
<% else %>
  <%= list_errors @user %>
  <%= form_for @user, url: { action: :typed_new_password_for_password_reset }, method: :post, html: { class: "general" } do |f| %>
    <% unless UserPasswordResetSystem.settings[:hide_username] %>
      <%= f.text_field :username, disabled: true, placeholder: User.human_attribute_name(:username) %>
    <% end %>
    <% pwd_min = User.const_defined?(:PASSWORD_MIN_LENGTH) ? User::PASSWORD_MIN_LENGTH : nil %>
    <% pwd_max = User.const_defined?(:PASSWORD_MAX_LENGTH) ? User::PASSWORD_MAX_LENGTH : nil %>
    <% if pwd_min %>
      <p class="help"><%= t('.password_min_length_hint', count: pwd_min) %></p>
    <% end %>
    <%= f.password_field :password, placeholder: t(".new_password"), **({ minlength: pwd_min } if pwd_min).to_h, **({ maxlength: pwd_max } if pwd_max).to_h %>
    <%= f.password_field :password_confirmation, placeholder: t(".new_password_confirmation"), **({ minlength: pwd_min } if pwd_min).to_h, **({ maxlength: pwd_max } if pwd_max).to_h %>
    <%= hidden_field_tag :token, params[:token] %>
    <%= hidden_field_tag :id, @password_reset_user_id || params[:id] || @user&.id %>
    <%= hidden_field_tag :submit_token, @submit_token %>
    <%= submit_tag t(".save") %>
  <% end %>
<% end %>
